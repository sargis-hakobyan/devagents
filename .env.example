# No credentials are required to start the service or run tests.
DEVAGENTS_DATA_DIR=.devagents
DEVAGENTS_PORT=4310
# Optional extra DevAgents execution restrictions. Off by default; engine sandbox stays active.
DEVAGENTS_RULES=false
# Shared by the service, coding agents and project builds/tests. Increase for large projects.
DEVAGENTS_CPUS=4
DEVAGENTS_MEMORY=4g
DEVAGENTS_PIDS=512
# Optional file containing user-owned configuration (see examples).
# DEVAGENTS_CONFIG=./devagents.yaml
# Provider secrets are read from environment; never put them in agent YAML.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
