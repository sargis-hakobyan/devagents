{
  "name": "devagents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first configurable AI development teams",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts serve",
    "cli": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/main.js serve",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "spike:mastra": "tsx scripts/mastra-spike.ts",
    "test:docker": "node scripts/docker-smoke.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mastra/core": "1.80.0",
    "@mastra/libsql": "1.27.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
