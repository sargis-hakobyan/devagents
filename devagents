#!/bin/sh
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "${1:-start}" in
  start) if [ "$#" -gt 0 ]; then shift; fi ;;
  *) echo 'Usage: ./devagents start [--replace-key]' >&2; exit 2 ;;
esac
case "$#:${1:-}" in
  0:|1:--replace-key) ;;
  *) echo 'Usage: ./devagents start [--replace-key]' >&2; exit 2 ;;
esac

docker compose up -d --build --wait
vault_exists=$(docker compose exec -T devagents node dist/cli/main.js auth vault-exists)
vault_id="devagents-vault-$(printf '%s' "$PWD" | openssl dgst -sha256 | awk '{print $NF}')"
master=$(./scripts/vault-key.sh "$vault_id" "$vault_exists")
printf '%s\n' "$master" | docker compose exec -T devagents node dist/cli/main.js auth unlock
unset master
docker compose exec devagents node dist/cli/main.js auth setup "$@"
echo 'DevAgents is ready at http://127.0.0.1:4310/health'
